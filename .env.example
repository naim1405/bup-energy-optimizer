# --- LLM (operator-note interpretation) -----------------------------------
# Standard OpenAI variable name. Required for /optimize-energy to interpret
# operator notes; without it the service still runs and every note is
# reported as no_op (valid schedule, directives not applied).
OPENAI_API_KEY=

# Model name. Configurable so it can be swapped without a code change.
LLM_MODEL=gpt-4o-mini

# Optional tuning. Defaults shown.
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT_SECONDS=8
# LLM_MAX_RETRIES=1
# LLM_BUDGET_SECONDS=24

# --- Queue (reserved, not used yet) ----------------------------------------
REDIS_URL=redis://localhost:6379/0
